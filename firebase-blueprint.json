  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Public account metadata and plan reference for users."
    },
    "/user_profiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Isolated private PII and creator profile data."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted administrator directory."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/Subscription" },
      "description": "Commercial plan subscriptions."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Digital store products catalog."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Persistent purchase orders."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Verified payment transactions."
    },
    "/usage_history/{usageId}": {
      "schema": { "$ref": "#/entities/UsageHistory" },
      "description": "AI tool usage history."
    },
    "/saved_projects/{projectId}": {
      "schema": { "$ref": "#/entities/SavedProject" },
      "description": "User saved creative projects."
    },
    "/support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Customer support tickets."
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Global application settings and manual Nubank Pix configuration."
    },
    "/chat_conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/ChatConversation" },
      "description": "Persistent AI chat conversations owned by users."
    },
    "/chat_conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Individual messages inside a chat conversation."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/Announcement" },
      "description": "Real-time platform announcements and updates."
    },
    "/user_notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Automatic internal notifications for users."
    },
    "/notification_reads/{readId}": {
      "schema": { "$ref": "#/entities/NotificationRead" },
      "description": "User read receipts for published announcements."
    }
  }
}
