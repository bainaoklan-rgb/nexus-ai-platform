{
  "entities": {
    "User": {
      "title": "User",
      "description": "Public and basic account metadata for a registered user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "minLength": 0
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "maxLength": 20
        },
        "planId": {
          "type": "string",
          "enum": ["free", "pro", "studio"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "photoURL", "role", "planId", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Isolated private PII and creator preferences for a user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "minLength": 3
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "minLength": 0
        },
        "bio": {
          "type": "string",
          "maxLength": 500,
          "minLength": 0
        },
        "niche": {
          "type": "string",
          "maxLength": 100,
          "minLength": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "phone", "bio", "niche", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
