          "format": "date-time"
        }
      },
      "required": ["id", "title", "description", "priceCents", "category", "imageUrl", "fileFormat", "active", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Persistent purchase order for plans or digital products.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemType": {
          "type": "string",
          "enum": ["plan", "product"],
          "maxLength": 20
        },
        "itemId": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "itemTitle": {
          "type": "string",
          "maxLength": 150,
          "minLength": 1
        },
        "amountCents": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["awaiting_payment", "pending_configuration", "pending_pix", "approved", "expired", "refunded", "cancelled"],
          "maxLength": 30
        },
        "externalReference": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "pixCopyPaste": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "itemType", "itemId", "itemTitle", "amountCents", "status", "externalReference", "pixCopyPaste", "createdAt", "updatedAt"]
    },
    "Payment": {
      "title": "Payment",
