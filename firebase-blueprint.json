      "required": ["id", "userId", "planId", "status", "priceCents", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Digital product catalog item.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
