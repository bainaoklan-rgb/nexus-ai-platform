        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "orderId", "userId", "amountCents", "status", "provider", "transactionId", "idempotencyKey", "createdAt", "updatedAt"]
    },
    "UsageHistory": {
      "title": "UsageHistory",
