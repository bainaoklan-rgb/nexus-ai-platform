# GEMINI_API_KEY: Obrigatória para execução das 8 ferramentas de IA e do Chat NEXUS no servidor.
# Configurada exclusivamente no servidor (painel Secrets do Google AI Studio / Cloud Run).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública oficial onde a aplicação está hospedada.
APP_URL="https://ais-pre-ymgwovy2ap2cish26msfkk-253742165772.us-east1.run.app"

# CUSTOM_DOMAIN: Domínio próprio da marca (ex: https://nexusaistudio.com.br) quando registrado e apontado via DNS.
CUSTOM_DOMAIN=""

# GOOGLE_SITE_VERIFICATION: Código opcional da meta tag google-site-verification do Google Search Console.
GOOGLE_SITE_VERIFICATION=""

# NOTA SOBRE PAGAMENTOS PIX (NUBANK MANUAL):
# Esta aplicação utiliza links oficiais de cobrança Pix do Nubank com aprovação protegida no servidor.
# A chave/links Pix Nubank, o titular e os preços dos planos ficam salvos em app_settings/global no Cloud Firestore.
